{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project coordinator v1 event",
  "type": "object",
  "required": [
    "op"
  ],
  "properties": {
    "op": {
      "enum": [
        "init",
        "add",
        "observe",
        "prepare",
        "issue",
        "ack",
        "result",
        "reconcile",
        "retire",
        "recover",
        "status",
        "rebind",
        "summary",
        "register",
        "report"
      ]
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "task": {
      "$ref": "#/$defs/task"
    },
    "task_id": {
      "type": "string"
    },
    "reporter": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "reporter_thread_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["lifecycle", "progress", "blocker", "handoff", "result"]},
    "occurred_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "detail": {"type": "string", "minLength": 1, "maxLength": 2000},
    "source": {"type": "string", "minLength": 1, "maxLength": 512},
    "claim_id": {"type": "string", "minLength": 1},
    "dispatch_id": {
      "type": "string"
    },
    "receipt": {
      "$ref": "#/$defs/file"
    },
    "source_digest": {
      "type": "string"
    },
    "scope_digest": {
      "type": "string"
    },
    "worker": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "quiescent": {
      "type": "boolean"
    },
    "expected_old_thread_id": {
      "type": "string",
      "minLength": 1
    },
    "new_thread_id": {
      "type": "string",
      "minLength": 1
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "report_offset": {"type": "integer", "minimum": 0},
    "report_limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "expected_workers": {
      "$ref": "#/$defs/project/properties/workers"
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "root",
        "linear_ref",
        "beads_ref",
        "coordinator_thread_id",
        "workers"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "linear_ref": {
          "type": "string",
          "minLength": 1
        },
        "beads_ref": {
          "type": "string",
          "minLength": 1
        },
        "coordinator_thread_id": {
          "type": "string",
          "minLength": 1
        },
        "workers": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^[a-z][a-z0-9_-]{0,63}$": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "linear_ref",
        "beads_ref",
        "worker",
        "prompt",
        "source_digest",
        "scope_digest",
        "dependencies",
        "writer_paths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "linear_ref": {
          "type": "string",
          "minLength": 1
        },
        "beads_ref": {
          "type": "string",
          "minLength": 1
        },
        "worker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "source_digest": {
          "type": "string",
          "minLength": 1
        },
        "scope_digest": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "writer_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "projectPolicy": {
      "type": "object",
      "required": [
        "schema_version",
        "project_id",
        "root",
        "worker_registrations",
        "legacy_leaseless_beads"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "worker_registrations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "worker",
              "thread_id"
            ],
            "properties": {
              "worker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "thread_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "legacy_leaseless_beads": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "beads_id",
              "assignee"
            ],
            "properties": {
              "beads_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "assignee": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "const": "init"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "project"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "add"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "task",
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "observe"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "worker",
          "state",
          "evidence",
          "project_id",
          "root"
        ],
        "properties": {
          "state": {
            "enum": ["IDLE", "BUSY", "UNKNOWN"]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "prepare"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "task_id",
          "source_digest",
          "scope_digest",
          "project_id",
          "root"
        ],
        "properties": {
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "issue"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "task_id",
          "dispatch_id",
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "ack"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "task_id",
          "dispatch_id",
          "receipt",
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "result"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "task_id",
          "dispatch_id",
          "receipt",
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "reconcile"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "task_id",
          "dispatch_id",
          "quiescent",
          "evidence",
          "project_id",
          "root"
        ],
        "properties": {
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "retire"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "task_id",
          "source_digest",
          "scope_digest",
          "quiescent",
          "evidence",
          "project_id",
          "root"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "source_digest": {
            "type": "string",
            "minLength": 1
          },
          "scope_digest": {
            "type": "string",
            "minLength": 1
          },
          "quiescent": {
            "const": true
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "status"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "recover"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "rebind"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "project_id",
          "root",
          "worker",
          "expected_old_thread_id",
          "new_thread_id",
          "evidence"
        ],
        "properties": {
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "summary"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "register"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "project_id",
          "root",
          "worker",
          "new_thread_id",
          "expected_workers",
          "evidence"
        ],
        "properties": {
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "new_thread_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "propertyNames": {
          "enum": [
            "op",
            "event_id",
            "project_id",
            "root",
            "worker",
            "new_thread_id",
            "expected_workers",
            "evidence"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "op": {"const": "report"}
        }
      },
      "then": {
        "required": ["event_id", "project_id", "root", "task_id", "reporter", "reporter_thread_id", "kind", "occurred_at", "state", "detail", "source", "evidence", "claim_id"],
        "properties": {
          "state": {"type": "string", "minLength": 1, "maxLength": 512},
          "evidence": {"type": "array", "maxItems": 16, "items": {"type": "string", "minLength": 1, "maxLength": 512}}
        },
        "propertyNames": {
          "enum": ["op", "event_id", "project_id", "root", "task_id", "reporter", "reporter_thread_id", "kind", "occurred_at", "state", "detail", "source", "evidence", "claim_id", "dispatch_id"]
        }
      }
    }
  ]
}
