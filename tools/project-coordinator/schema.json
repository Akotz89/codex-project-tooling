{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project coordinator v1 event",
  "type": "object",
  "required": [
    "op"
  ],
  "properties": {
    "op": {
      "enum": [
        "init",
        "add",
        "observe",
        "prepare",
        "issue",
        "ack",
        "result",
        "reconcile",
        "recover",
        "status",
        "rebind",
        "summary"
      ]
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "task": {
      "$ref": "#/$defs/task"
    },
    "task_id": {
      "type": "string"
    },
    "dispatch_id": {
      "type": "string"
    },
    "receipt": {
      "$ref": "#/$defs/file"
    },
    "source_digest": {
      "type": "string"
    },
    "scope_digest": {
      "type": "string"
    },
    "worker": {
      "$ref": "#/$defs/worker_role"
    },
    "state": {
      "enum": [
        "IDLE",
        "BUSY",
        "UNKNOWN"
      ]
    },
    "evidence": {
      "type": "string"
    },
    "quiescent": {
      "type": "boolean"
    },
    "expected_old_thread_id": {
      "type": "string",
      "minLength": 1
    },
    "new_thread_id": {
      "type": "string",
      "minLength": 1
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "required": [
        "project_id",
        "root",
        "linear_ref",
        "beads_ref",
        "coordinator_thread_id",
        "workers"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "linear_ref": {
          "type": "string",
          "minLength": 1
        },
        "beads_ref": {
          "type": "string",
          "minLength": 1
        },
        "coordinator_thread_id": {
          "type": "string",
          "minLength": 1
        },
        "workers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/worker_role"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "linear_ref",
        "beads_ref",
        "worker",
        "prompt",
        "source_digest",
        "scope_digest",
        "dependencies",
        "writer_paths"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "linear_ref": {
          "type": "string",
          "minLength": 1
        },
        "beads_ref": {
          "type": "string",
          "minLength": 1
        },
        "worker": {
          "$ref": "#/$defs/worker_role"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "source_digest": {
          "type": "string",
          "minLength": 1
        },
        "scope_digest": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "writer_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "worker_role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}(?![\\s\\S])",
      "maxLength": 64
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "const": "init"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "project"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "add"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "task",
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "observe"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "worker",
          "state",
          "evidence",
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "prepare"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "task_id",
          "source_digest",
          "scope_digest",
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "issue"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "task_id",
          "dispatch_id",
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "ack"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "task_id",
          "dispatch_id",
          "receipt",
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "result"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "task_id",
          "dispatch_id",
          "receipt",
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "reconcile"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "task_id",
          "dispatch_id",
          "quiescent",
          "evidence",
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "status"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "recover"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "root"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "rebind"
          }
        }
      },
      "then": {
        "required": [
          "event_id",
          "project_id",
          "root",
          "worker",
          "expected_old_thread_id",
          "new_thread_id",
          "evidence"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "summary"
          }
        }
      },
      "then": {
        "required": [
          "project_id",
          "root"
        ]
      }
    }
  ]
}
